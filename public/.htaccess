# Ativa o mecanismo de reescrita.
RewriteEngine On

# Desativa a geração automática de ETag para arquivos estáticos.
FileETag None

# Desativa a compressão gzip.
<IfModule mod_deflate.c>
    SetEnv no-gzip 1
</IfModule>

# Desativa a listagem de arquivos dos diretórios.
Options -Indexes

# Remove a barra final da URL, exceto para diretórios existentes.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)/$ /$1 [R=301,L]

# Entrega o favicon existente ou retorna 404, sem chamar o bootstrap.
RewriteCond %{REQUEST_URI} ^/favicon\.ico$
RewriteCond %{DOCUMENT_ROOT}/favicon.ico !-f
RewriteRule ^.*$ - [R=404,L]

RewriteRule ^favicon\.ico$ - [END]

# Preserva diretórios existentes e encaminha as demais requisições ao bootstrap,
# exceto as tratadas pelas regras anteriores.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,END]